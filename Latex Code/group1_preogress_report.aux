\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Phase 1: GCN scheduling strategy comparison showing (left) Test $R^2$ and (right) Test MAE across 5 random seeds. Learnable scheduling achieves the best mean performance with lowest variance.}}{9}{figure.caption.6}\protected@file@percent }
